@using Shop.Data.ViewModell;

@model VMItems
@{
    Layout = "_Layout";
}

<div>
    <select onchange="SelectCategory(this)">
        <option value="0">Выбрать...</option>
        @foreach(var Category in Model.Categories) {
            if(Category.Id == Model.SelectCategory) {
                <option selected="selected" value="@Category.Id">@Category.Name</option>
            } else {
                <option value="@Category.Id">@Category.Name</option>
            }
        }
    </select>
    <a href="/Items/Add">Добавить товар</a>
</div>

<h2>Все предметы</h2>

@foreach (var item in Model.Items)
{
    <div class="item">
        <img src="@Url.Content(item.Img)" alt="@item.Name"/>
        <div class="data">
            <h3>Модель: @item.Name</h3>
            <div>Цена: @item.Price.ToString("c")</div>
            <div>Категория: @item.Category.Name</div>
            <div>Описание: @item.Description</div>
            
            <!-- Кнопки действий -->
            <div class="actions">
                <a href="/Items/Update/@item.Id">Редактировать</a>
                
                <form method="post" action="/Items/Delete" style="display:inline;" 
                      onsubmit="return confirm('Удалить @item.Name?');">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="delete-btn">Удалить</button>
                </form>
            </div>
        </div>
    </div>

    if(item.Category.Id == Model.SelectCategory) {
        <div class="item">
            <img src="@item.Img"/>
            <div class="basket">
                <div class="button" id="@item.Id">
                    В корзину
                </div>
                <div class="count">
                    <div class="button_min">-</div>
                    <div class="text">1</div>
                    <div class="button_max">+</div>
                </div>
            </div>
        </div>
    }
}

<script>
    function SelectCategory(sender) {
        window.location = "/Items/List?Id=" + sender.value;
    }
</script>

<style>
    .actions {
        margin-top: 10px;
    }
    .actions a, .actions button {
        margin-right: 10px;
        padding: 5px 10px;
        text-decoration: none;
        border: 1px solid #ddd;
        border-radius: 3px;
        cursor: pointer;
    }
    .delete-btn {
        background-color: #ff4444;
        color: white;
        border: none;
    }
</style>